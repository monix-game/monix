        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(monix_http_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
